# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会入库）

# DeepSeek，申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MySQL：建议用专用账号而不是 root
DB_URL=jdbc:mysql://127.0.0.1:3306/homework_grader?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=homework_app
DB_PASSWORD=请填写

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 跨域：仅 H5 端本地调试需要，小程序不需要。生产必须留空。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:10086,http://localhost:10086

# 对象存储实现：minio（本地开发）/ cos（生产）/ local（本地磁盘）/ auto
STORAGE_PROVIDER=minio

# MinIO：启动方式见 scripts/start-minio.sh
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=请填写
MINIO_SECRET_KEY=请填写
MINIO_BUCKET=homework-grader

# 腾讯云 COS：切生产时用，并把 STORAGE_PROVIDER 改成 cos
# 务必用子账号密钥，只授予目标桶的读写权限
COS_SECRET_ID=
COS_SECRET_KEY=
# 完整桶名（含 -APPID 后缀）时 COS_APP_ID 可留空
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_APP_ID=

# 腾讯云 OCR：用于给错题在原图上定位（选框）
# 默认复用上面 COS 的同一对子账号密钥；要单独授权时再填这两个
OCR_ENABLED=true
OCR_BOX_ENABLED=true
# OCR_SECRET_ID=
# OCR_SECRET_KEY=
OCR_REGION=ap-guangzhou
# GeneralAccurateOCR = 通用文字识别（高精度版），手写体场景更准
OCR_ACTION=GeneralAccurateOCR

# 批改：是否生成错题的原图裁剪。只有拿到可靠坐标（OCR 匹配 / 用户手动框选）的题目才会裁
GRADING_CROP_ENABLED=true
# 是否允许用模型自报的坐标裁剪（默认关闭，偏差可达数行）
GRADING_CROP_ALLOW_AI_BBOX=false

# 微信小程序
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
# 允许请求携带 devIdentity 直接登录（本地调试与自动化测试用）。生产必须为 false
WX_DEV_LOGIN_ENABLED=true
