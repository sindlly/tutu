{
  "name": "homework-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "拍照批改作业小程序",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp:online": "TARO_APP_API_BASE=https://www.zycquet.com/tutu taro build --type weapp",
    "dev:weapp:online": "TARO_APP_API_BASE=https://www.zycquet.com/tutu taro build --type weapp --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tarojs/cli": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "^18.2.74",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.3.0",
    "miniprogram-automator": "^0.13.0",
    "postcss": "^8.4.38",
    "react-refresh": "^0.19.0",
    "sass": "^1.75.0",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0"
  }
}
